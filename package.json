{
  "name": "vscode-mcp",
  "displayName": "VSCode MCP",
  "description": "通过本地 MCP 服务向外部 Agent 提供 VS Code 工作区、文件编辑和诊断能力",
  "version": "0.5.1",
  "publisher": "Evan-Xu-vibe",
  "repository": { "type": "git", "url": "https://github.com/Evan-Xu-vibe/vscode-mcp.git" },
  "icon": "resources/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "未受信任工作区仅提供读取功能。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-mcp.start",
        "title": "启动 MCP 服务",
        "category": "VSCode MCP",
        "icon": "$(play)"
      },
      {
        "command": "vscode-mcp.stop",
        "title": "停止 MCP 服务",
        "category": "VSCode MCP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vscode-mcp.copyConnection",
        "title": "复制 MCP 连接信息",
        "category": "VSCode MCP",
        "icon": "$(copy)"
      },
      {
        "command": "vscode-mcp.showLog",
        "title": "查看调用日志",
        "category": "VSCode MCP",
        "icon": "$(output)"
      },
      {
        "command": "vscode-mcp.openSettings",
        "title": "显示侧边栏配置",
        "category": "VSCode MCP",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vscode-mcp.toggleAutoStart",
        "title": "切换自动启动",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.toggleWrites",
        "title": "切换文件修改权限",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.toggleApproval",
        "title": "切换修改确认",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.toggleTasks",
        "title": "切换任务执行",
        "category": "VSCode MCP"
      },
      { "command": "vscode-mcp.toggleDebug", "title": "切换调试控制", "category": "VSCode MCP" },
      { "command": "vscode-mcp.toggleDebugEvaluation", "title": "切换调试表达式求值", "category": "VSCode MCP" },
      {
        "command": "vscode-mcp.toggleTerminals",
        "title": "切换终端读写",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.configureTasks",
        "title": "配置允许的任务",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.checkConnection",
        "title": "连接自检",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.configureBlockedPaths",
        "title": "配置禁止读写路径",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.configureSearchExclude",
        "title": "配置搜索排除规则",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.setSearchMaxFiles",
        "title": "设置搜索文件上限",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.toggleAuth",
        "title": "切换连接验证",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.setKey",
        "title": "设置自定义 Key",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.clearKey",
        "title": "清除自定义 Key",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.restart",
        "title": "重启 MCP 服务",
        "category": "VSCode MCP",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-mcp.copyClient",
        "title": "复制客户端配置",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.copyCodex",
        "title": "复制 Codex 配置",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.copyOpenCode",
        "title": "复制 OpenCode 配置",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.setPort",
        "title": "设置连接端口",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.clearHistory",
        "title": "清除调用记录",
        "category": "VSCode MCP",
        "icon": "$(clear-all)"
      },
      {
        "command": "vscode-mcp.reviewOpen",
        "title": "查看待确认修改",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.reviewAccept",
        "title": "接受待确认修改",
        "category": "VSCode MCP"
      },
      {
        "command": "vscode-mcp.reviewReject",
        "title": "拒绝待确认修改",
        "category": "VSCode MCP"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-mcp",
          "title": "VSCode MCP",
          "icon": "resources/mcp.svg"
        }
      ]
    },
    "views": {
      "vscode-mcp": [
        {
          "id": "vscode-mcp.controls",
          "name": "服务控制",
          "contextualTitle": "VSCode MCP"
        },
        {
          "id": "vscode-mcp.reviews",
          "name": "待确认修改"
        },
        {
          "id": "vscode-mcp.calls",
          "name": "调用记录"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-mcp.start",
          "when": "view == vscode-mcp.controls && !vscodeMcp.running",
          "group": "navigation@1"
        },
        {
          "command": "vscode-mcp.stop",
          "when": "view == vscode-mcp.controls && vscodeMcp.running",
          "group": "navigation@1"
        },
        {
          "command": "vscode-mcp.copyConnection",
          "when": "view == vscode-mcp.controls && vscodeMcp.running",
          "group": "navigation@2"
        },
        {
          "command": "vscode-mcp.showLog",
          "when": "view == vscode-mcp.controls",
          "group": "navigation@3"
        },
        {
          "command": "vscode-mcp.openSettings",
          "when": "view == vscode-mcp.controls",
          "group": "navigation@4"
        },
        {
          "command": "vscode-mcp.clearHistory",
          "when": "view == vscode-mcp.calls",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "VSCode MCP",
      "properties": {
        "vscodeMcp.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "窗口启动后自动启动 MCP 服务（修改后重新加载窗口）。"
        },
        "vscodeMcp.port": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "本地监听端口，0 表示自动分配。修改后停止并重新启动服务。"
        },
        "vscodeMcp.auth.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否要求客户端提供 Bearer Key。修改后重启 MCP 服务。自定义 Key 通过侧边栏设置并存入 VS Code 密钥存储。"
        },
        "vscodeMcp.blockedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "maxItems": 100,
          "default": [],
          "description": "禁止 MCP 文件接口读写的文件或目录路径，目录包含全部子项。支持绝对路径、相对于各工作区根目录的路径，不支持 glob。立即生效，搜索排除参数不能覆盖。终端、任务及调试执行不受此限制。"
        },
        "vscodeMcp.allowWrites": {
          "type": "boolean",
          "default": true,
          "description": "允许客户端创建、修改和保存工作区文件。"
        },
        "vscodeMcp.requireApproval": {
          "type": "boolean",
          "default": false,
          "description": "将文件修改和保存请求放入待确认修改面板，由用户接受后执行。立即生效。"
        },
        "vscodeMcp.terminals.enabled": {
          "type": "boolean",
          "default": false,
          "description": "允许 Agent 读取本机窗口终端输出、创建 / 关闭终端并发送任意命令和输入。命令可访问工作区外，不受文件修改或任务允许列表限制。仅受信任工作区可用；输出读取需要 VS Code 1.93+ 及 Shell Integration，无法补读历史。"
        },
        "vscodeMcp.debug.enabled": { "type": "boolean", "default": false, "description": "允许 Agent 启动 / 停止本机调试会话、管理断点、单步执行以及读取调用栈和变量。仅受信任工作区可用；可能运行 preLaunchTask，变量可能包含敏感信息。独立于文件和任务权限。" },
        "vscodeMcp.debug.allowEvaluation": { "type": "boolean", "default": false, "description": "允许 Agent 在暂停帧中求值表达式和创建条件断点 / 日志表达式，可能执行任意程序代码。同时需要 debug.enabled。" },
        "vscodeMcp.tasks.enabled": {
          "type": "boolean",
          "default": false,
          "description": "允许 Agent 执行已有 VS Code 任务。仅受信任工作区可用，同时需要配置允许的任务名称。"
        },
        "vscodeMcp.tasks.allowedNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "允许 Agent 执行的 VS Code 任务名称，按名称精确匹配。"
        },
        "vscodeMcp.search.exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 50,
          "default": [
            "**/{node_modules,out,dist,.vscode-test}/**"
          ],
          "description": "搜索排除 glob，可从侧边栏增删。Git 元数据始终排除。仅影响新搜索。"
        },
        "vscodeMcp.search.maxFiles": {
          "type": "integer",
          "default": 10000,
          "minimum": 100,
          "maximum": 50000,
          "description": "新搜索最多发现的候选文件数；按页继续扫描，超过上限会标记 discoveryTruncated。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit -p ./",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links --no-dependencies",
    "test": "npm run compile && node scripts/test.mjs",
    "test:unit": "npm run compile && node --test out/test/core.test.js out/test/server.test.js out/test/connection.test.js out/test/terminals.test.js out/test/debugger.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "3.25.76"
  }
}
